+def info_bar_cut(cp, dpi=DPI):
+    """Last row of the Pre-Press Pro info bar, or None if it cannot be found.
+
+    The filename and swatch label block sit in a margin strip above the
+    artwork. They are painted in each ink, so a pixel measurement that counts
+    them is measuring furniture, not the design - and because the label block
+    never sits on the base, it drags underbase coverage down and produces a
+    yellow flag on a file that is correct.
+
+    Neither the layer nor the ink can tell them apart: art legitimately lives
+    on the marks layer, and the labels are painted in their own inks by design.
+    POSITION can, which is the same discriminator ART_TEXT_OUTLINED uses.
+
+    The bar is a stack of thin, light, evenly spaced text bands starting at the
+    top. Walk down while bands match that signature and stop at the first one
+    that does not. Measured per file rather than fixed, because the bar grows
+    with the ink count - 0.59in for one ink, 1.09in for five.
+
+    Returns None when no bar is found OR when the bar ends too close to the
+    first artwork band. Excluding the wrong rows would hide a real defect,
+    which is worse than the flag this exists to prevent, so an uncertain
+    reading declines to cut rather than guessing.
+    """
+    ink = None
+    for k, v in cp.items():
+        if k in ("Cyan", "Magenta", "Yellow", "Black", "All") or v.sum() < 50:
+            continue
+        ink = v if ink is None else (ink | v)
+    if ink is None:
+        return None
+    rows = ink.sum(axis=1)
+    nz = np.where(rows > 0)[0]
+    if len(nz) == 0:
+        return None
+
+    bands, start = [], None
+    for i in range(nz[0], nz[-1] + 2):
+        has = i <= nz[-1] and rows[i] > 0
+        if has and start is None:
+            start = i
+        elif not has and start is not None:
+            bands.append((start, i - 1, int(rows[start:i].sum())))
+            start = None
+
+    total = int(ink.sum())
+    max_band_in = 0.22          # a label line measures ~0.13in; allow headroom
+    max_share = max(total * 0.02, 6000)
+    top_strip_in = 3.0          # the bar never begins this far down
+    cut = None
+    for s, e, px in bands:
+        if ((e - s + 1) / dpi <= max_band_in and px <= max_share
+                and s / dpi < top_strip_in):
+            cut = e
+        else:
+            break
+    if cut is None:
+        return None
+
+    after = [b for b in bands if b[0] > cut]
+    if not after:
+        return None
+    # Refuse the cut when the bar crowds the artwork. Observed separation is
+    # 0.16in at its narrowest across the corpus, but the bar grows with ink
+    # count and the corpus tops out at five inks.
+    if (after[0][0] - cut) / dpi < 0.10:
+        return None
+    return cut
+
