+def text_rows_for(artboard, dpi=DPI):
+    """Live-text origins on an artboard, as raster rows at `dpi`.
+
+    PDF y runs up from the artboard's bottom edge; raster rows run down from
+    its top, so the two are mirrored about the board height.
+    """
+    hpt = float(artboard.get("height_in") or 0) * 72.0
+    out = []
+    for pos in artboard.get("text_positions") or []:
+        try:
+            out.append(int(round((hpt - float(pos[1])) / 72.0 * dpi)))
+        except (TypeError, ValueError, IndexError):
+            continue
+    return out
+
