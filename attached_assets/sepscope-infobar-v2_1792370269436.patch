+def t_info_bar_excluded_from_coverage(need):
+    """The filename and swatch label block are painted in each ink and never
+    sit on the base, so counting them drags underbase coverage down and yellow-
+    flags a correct file. -22771 LC reads 83.9% on Brown 7518 C with the strip
+    counted and 92.2% without it, which is the difference between a flag and a
+    pass. Neither layer nor ink can tell furniture from art; position can.
+    """
+    src = find("22771 LC") or find("22906 LC OUTPUT 1")
+    if not src:
+        return "skip"
+    facts = EX.extract(src)
+    und = [ab for ab in facts["artboards"] if ab["is_underbase"]]
+    cols = [ab for ab in facts["artboards"] if not ab["is_underbase"] and ab["inks"]]
+    if not und or not cols:
+        return "fixture has no underbase artboard"
+    cp = RS.plates(src, cols[0]["index"], 200)
+    cut = RS.info_bar_cut(cp, RS.text_rows_for(cols[0]), 200)
+    if cut is None:
+        return "info bar was not located on a fixture that has one"
+    if not 0.4 < cut / 200.0 < 1.25:
+        return f"info bar cut at {cut / 200.0:.2f}in is outside the observed band"
+    cov, based, bar = RS.base_coverage(src, cols[0]["index"], und[0]["index"],
+                                      text_rows=RS.text_rows_for(cols[0]))
+    if bar != cut:
+        return "base_coverage did not report the row it excluded"
+    for ink, d in cov.items():
+        if "Brown" in ink and d["pct"] < 85:
+            return (f"{ink} still reads {d['pct']}% - the info bar is still "
+                    "being counted")
+    return True
+
