+def t_info_bar_detector_is_conservative(need):
+    """The detector must not mistake artwork for the label block.
+
+    Raised in review: a small design element above a larger one has the shape
+    of a label line, and the earlier version excluded it as furniture. The
+    discriminator is live text - Pre-Press Pro writes the filename and labels
+    as live text, while artwork text is outlined and has no text origin at all.
+
+    Three layouts the detector must decline, and one it must accept.
+    """
+    import numpy as np
+    H, W = 1000, 3200
+
+    def plate(parts):
+        m = np.zeros((H, W), bool)
+        for a, b, c, d in parts:
+            m[a:b, c:d] = True
+        return {"5-230-Ink": m}
+
+    small_above_large = plate([(60, 100, 1500, 1700), (300, 900, 800, 2400)])
+
+    # 1. no label block at all - a small element above a larger one
+    if RS.info_bar_cut(small_above_large, [], 200) is not None:
+        return "excluded a small artwork element as if it were a label line"
+
+    # 2. live text exists on the board but not in that band
+    if RS.info_bar_cut(small_above_large, [950], 200) is not None:
+        return "excluded artwork on the strength of text somewhere else"
+
+    # 3. no text information supplied - must decline rather than guess
+    if RS.info_bar_cut(small_above_large, None, 200) is not None:
+        return "guessed at the info bar with no text positions to go on"
+
+    # 4. labels sitting too close to the artwork - the separation guard
+    crowded = plate([(28, 54, 1200, 2000), (60, 900, 800, 2400)])
+    if RS.info_bar_cut(crowded, [53], 200) is not None:
+        return "cut a bar that crowds the artwork instead of declining"
+
+    # 5. a genuine two-line bar, clear of the art, with text on both lines
+    real = plate([(28, 54, 1200, 2000), (92, 118, 1200, 2000), (300, 900, 800, 2400)])
+    cut = RS.info_bar_cut(real, [53, 117], 200)
+    if cut is None:
+        return "failed to find a well-formed info bar"
+    if not 110 <= cut <= 125:
+        return f"bar ended at row {cut}, expected the second label line"
+    return True
+
