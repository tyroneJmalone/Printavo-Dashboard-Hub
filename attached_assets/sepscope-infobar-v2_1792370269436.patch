+def info_bar_cut(cp, text_rows=None, dpi=DPI):
+    """Last row of the Pre-Press Pro info bar, or None if it cannot be found.
+
+    The filename and swatch label block sit in a margin strip above the
+    artwork. They are painted in each ink, so a pixel measurement that counts
+    them is measuring furniture, not the design - and because the label block
+    never sits on the base, it drags underbase coverage down and produces a
+    yellow flag on a file that is correct.
+
+    Neither the layer nor the ink can tell them apart: art legitimately lives
+    on the marks layer, and the labels are painted in their own inks by design.
+    POSITION and LIVE TEXT can, together.
+
+    Three conditions must all hold for a band to count as part of the bar:
+
+    1. It sits in the top strip and is thin and light - the shape of a label
+       line rather than artwork.
+    2. **It contains a live-text origin.** This is the condition that matters.
+       Pre-Press Pro writes the filename and labels as live text; artwork text
+       is outlined and so has no text origin at all. Without this gate, a small
+       design element sitting above a larger one is indistinguishable from a
+       label line, and gets excluded as furniture. Measured across the corpus:
+       every band of every real info bar contains a text origin.
+    3. The bar must end clear of the first artwork band.
+
+    `text_rows` are raster rows of live-text origins on this artboard. When it
+    is None the function declines rather than guessing, because without the
+    text gate conditions 1 and 3 alone are not conservative enough.
+
+    Returns None when the bar cannot be identified. Excluding the wrong rows
+    would hide a real defect, which is worse than the flag this exists to
+    prevent, so an uncertain reading declines to cut.
+    """
+    if not text_rows:
+        return None
+    ink = None
+    for k, v in cp.items():
+        if k in ("Cyan", "Magenta", "Yellow", "Black", "All") or v.sum() < 50:
+            continue
+        ink = v if ink is None else (ink | v)
+    if ink is None:
+        return None
+    rows = ink.sum(axis=1)
+    nz = np.where(rows > 0)[0]
+    if len(nz) == 0:
+        return None
+
+    bands, start = [], None
+    for i in range(nz[0], nz[-1] + 2):
+        has = i <= nz[-1] and rows[i] > 0
+        if has and start is None:
+            start = i
+        elif not has and start is not None:
+            bands.append((start, i - 1, int(rows[start:i].sum())))
+            start = None
+
+    total = int(ink.sum())
+    max_band_in = 0.22          # a label line measures ~0.13in; allow headroom
+    top_strip_in = 3.0          # the bar never begins this far down
+    pad = int(round(0.07 * dpi))   # a text origin sits on the glyph baseline
+
+    def has_text(s, e):
+        return any(s - pad <= t <= e + pad for t in text_rows)
+
+    # The bar runs from the topmost ink band down. If the first band does not
+    # qualify there is no bar, and no later band can start one.
+    cut = None
+    for s, e, px in bands:
+        if ((e - s + 1) / dpi <= max_band_in
+                and s / dpi < top_strip_in and has_text(s, e)):
+            cut = e
+        else:
+            break
+    if cut is None:
+        return None
+
+    after = [b for b in bands if b[0] > cut]
+    if not after:
+        return None
