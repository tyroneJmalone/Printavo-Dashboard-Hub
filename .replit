modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"
ignorePorts = false

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["resend:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "glibcLocales", "gumbo", "harfbuzz", "jbig2dec", "lcms2", "libimagequant", "libjpeg", "libjpeg_turbo", "libtiff", "libwebp", "libxcrypt", "mupdf", "openjpeg", "pkg-config", "qpdf", "swig", "tcl", "tk", "xcbuild", "xsimd", "zlib"]

[userenv]

[userenv.development]
VENDOR_SUBMIT_ENABLED = "true"
PRINTAVO_TASK_SYNC_ENABLED = "true"

[userenv.shared]
MINTBUCKS_APP_URL = "https://mintbucks.replit.app"
PRINTAVO_API_KEY = "wR0rHQdkL8KlzV2F2-naTA"

[userenv.production]
KB_DRIVE_SYNC_ENABLED = "true"
VENDOR_SUBMIT_ENABLED = "true"
