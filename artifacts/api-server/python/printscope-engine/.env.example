# Every path and tunable the engine reads. Defaults resolve next to config.py.
PRINTSCOPE_RULES=./printscope-rules-v2.csv
PRINTSCOPE_QUEUE=./queue
PRINTSCOPE_SITE=./site
PRINTSCOPE_GS=gs
PRINTSCOPE_MUTOOL=mutool

# 200 dpi is what the trap thresholds in the rule table were calibrated at.
# Changing it moves the numbers — recalibrate if you do.
PRINTSCOPE_MEASURE_DPI=200
PRINTSCOPE_FALLBACK_DPI=600
PRINTSCOPE_SVG_MAX_BYTES=2500000

# Cross-cutting measurement constant, not a rule threshold. See README.
PRINTSCOPE_BASED_INK_PCT=85

# Stamped onto every result alongside the rule-table fingerprint.
PRINTSCOPE_ENGINE_VERSION=0.4.0

# Used by test_engine.py and export_golden.py
PRINTSCOPE_CORPUS=/path/to/printscope-fixtures
